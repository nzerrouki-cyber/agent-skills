# GCP Project Configuration
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# GCS Bucket URIs
INTAKE_RAW_BUCKET=intake-ideas-bucket/raw
SKILL_DRAFTS_BUCKET=enterprise-skillbank/drafts
SKILL_PROD_BUCKET=enterprise-skillbank/production

# Database & Cache URIs
REDIS_CACHE_URL=redis://redis-master.default.svc.cluster.local:6379
FIRESTORE_REGISTRY_COLLECTION=skill_registry
FIRESTORE_SESSION_STORE=live_chat_sessions
FIRESTORE_INTAKE_SESSION_STORE=intake_chat_sessions
FIRESTORE_GEM_CREATOR_SESSION_STORE=gem_creator_sessions

# BigQuery Audit Database
BQ_DATASET_ID=agentic_workflow_metrics
BQ_AUDIT_TABLE=worker_execution_logs

# Cloud Tasks Configuration
TASK_QUEUE_NAME=worker-dispatch-queue
WORKER_SERVICE_URL=http://worker-service.default.svc.cluster.local:8000